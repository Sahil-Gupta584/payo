# ── App ───────────────────────────────────────────────────────────────────────
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=                        # npx -y @better-auth/cli secret

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://username:password@localhost:5432/pay

# ── Solari ────────────────────────────────────────────────────────────────────
SOLARI_API_KEY=                            # console.getsolari.com → API Keys
SOLARI_PROFILE_ID=                          # console.getsolari.com → Profiles

# ── Platform card (used to pay on behalf of users) ────────────────────────────
PLATFORM_CARD_NUMBER=
PLATFORM_CARD_EXPIRY=                      # MM / YY
PLATFORM_CARD_CVV=

# ── QuickCommerce API ─────────────────────────────────────────────────────────
QUICKCOMMERCE_API_KEY=                     # quickcommerceapi.com → Dashboard
RESEND_API_KEY=                            # resend.com → API Keys

# ── Dodo Payments (wallet top-up, required) ─────────────────────────────────
DODO_PAYMENTS_API_KEY=                     # dodopayments.com → Dashboard
DODO_PAYMENTS_WEBHOOK_KEY=                 # Dodo dashboard → Webhooks
DODO_PAYMENTS_WALLET_PRODUCT_ID=           # Dodo dashboard → Products
# DODO_PAYMENTS_ENVIRONMENT=test_mode      # test_mode | live_mode

# ── Sentry (optional) ─────────────────────────────────────────────────────────
VITE_SENTRY_DSN=
VITE_SENTRY_ORG=
VITE_SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
